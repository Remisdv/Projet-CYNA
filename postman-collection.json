{
  "info": {
    "name": "CYNA BO API Tests",
    "description": "Collection de tests pour l'API Back Office CYNA.\n\n**Auth automatique** : le pre-request script se connecte automatiquement si aucun token n'est stocke. Les tests de creation stockent automatiquement les IDs pour les requetes suivantes.\n\nVariables : `baseUrl`, `email`, `password`, `access_token`, `refresh_token`, `lastAdId`, `lastCategoryId`, `lastCarouselId`, `lastFaqId`, `lastFaqChildId`.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{access_token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost", "type": "string" },
    { "key": "access_token", "value": "", "type": "string" },
    { "key": "refresh_token", "value": "", "type": "string" },
    { "key": "email", "value": "admin@example.com", "type": "string" },
    { "key": "password", "value": "password123", "type": "string" },
    { "key": "lastAdId", "value": "", "type": "string" },
    { "key": "lastCategoryId", "value": "", "type": "string" },
    { "key": "lastCarouselId", "value": "", "type": "string" },
    { "key": "lastFaqId", "value": "", "type": "string" },
    { "key": "lastFaqChildId", "value": "", "type": "string" }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "const token = pm.collectionVariables.get('access_token');",
          "if (token) return;",
          "const baseUrl  = pm.collectionVariables.get('baseUrl');",
          "const email    = pm.collectionVariables.get('email');",
          "const password = pm.collectionVariables.get('password');",
          "pm.sendRequest({",
          "  url: baseUrl + '/api/bo/auth/login',",
          "  method: 'POST',",
          "  header: { 'Content-Type': 'application/json' },",
          "  body: { mode: 'raw', raw: JSON.stringify({ email, password }) }",
          "}, function (err, res) {",
          "  if (err || (res.code !== 200 && res.code !== 201)) {",
          "    console.error('[Auto-login] Echec', err || res.code); return;",
          "  }",
          "  const body = res.json();",
          "  if (body.access_token) {",
          "    pm.collectionVariables.set('access_token', body.access_token);",
          "    pm.collectionVariables.set('refresh_token', body.refresh_token || '');",
          "    console.log('[Auto-login] Tokens stockes');",
          "  }",
          "});"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "Health Check",
      "request": {
        "auth": { "type": "noauth" },
        "method": "GET",
        "header": [],
        "url": { "raw": "{{baseUrl}}/api/bo/health", "host": ["{{baseUrl}}"], "path": ["api","bo","health"] }
      }
    },
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login",
          "event": [{
            "listen": "test",
            "script": { "type": "text/javascript", "exec": [
              "pm.test('Status 200 ou 201', () => pm.expect(pm.response.code).to.be.oneOf([200,201]));",
              "const body = pm.response.json();",
              "pm.test('access_token present', () => pm.expect(body.access_token).to.be.a('string').and.not.empty);",
              "pm.test('refresh_token present', () => pm.expect(body.refresh_token).to.be.a('string').and.not.empty);",
              "if (body.access_token) {",
              "  pm.collectionVariables.set('access_token', body.access_token);",
              "  pm.collectionVariables.set('refresh_token', body.refresh_token || '');",
              "}"
            ]}
          }],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}" },
            "url": { "raw": "{{baseUrl}}/api/bo/auth/login", "host": ["{{baseUrl}}"], "path": ["api","bo","auth","login"] }
          }
        },
        {
          "name": "Refresh Token",
          "event": [{
            "listen": "test",
            "script": { "type": "text/javascript", "exec": [
              "pm.test('Status 200 ou 201', () => pm.expect(pm.response.code).to.be.oneOf([200,201]));",
              "const body = pm.response.json();",
              "pm.test('Nouveau access_token recu', () => pm.expect(body.access_token).to.be.a('string').and.not.empty);",
              "if (body.access_token) {",
              "  pm.collectionVariables.set('access_token', body.access_token);",
              "  if (body.refresh_token) pm.collectionVariables.set('refresh_token', body.refresh_token);",
              "}"
            ]}
          }],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"refresh_token\": \"{{refresh_token}}\"\n}" },
            "url": { "raw": "{{baseUrl}}/api/bo/auth/refresh", "host": ["{{baseUrl}}"], "path": ["api","bo","auth","refresh"] }
          }
        },
        {
          "name": "Logout",
          "event": [{
            "listen": "test",
            "script": { "type": "text/javascript", "exec": [
              "pm.collectionVariables.set('access_token', '');",
              "pm.collectionVariables.set('refresh_token', '');",
              "pm.test('Status 200 ou 201', () => pm.expect(pm.response.code).to.be.oneOf([200,201]));"
            ]}
          }],
          "request": {
            "method": "POST",
            "header": [],
            "url": { "raw": "{{baseUrl}}/api/bo/auth/logout", "host": ["{{baseUrl}}"], "path": ["api","bo","auth","logout"] }
          }
        }
      ]
    },
