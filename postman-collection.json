          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/bo/promotionnel",
              "host": ["{{baseUrl}}"],
              "path": ["api", "bo", "promotionnel"]
            }
          }
        },
        {
          "name": "Récupérer le texte actif",
          "request": {
            "auth": { "type": "noauth" },
