# CYNA Gateway API Configuration

# Server
NODE_ENV=development
PORT=3000
CORS_ORIGIN=http://localhost:5173

# BO API URLs
BO_API_HOST=localhost
BO_API_PORT=3001
BO_API_URL=http://localhost:3001

# Service API URLs
SERVICE_API_HOST=localhost
SERVICE_API_PORT=3002
SERVICE_API_URL=http://localhost:3002

# JWT Secret (must be same as BO API for token verification)
JWT_SECRET=your-secret-key-change-in-production-min-32-chars
