# Dockerfile NestJS avec Hot Reload pour le developpement
FROM node:20-alpine

# Argument pour le nom de l'application
ARG APP_NAME
ENV APP_NAME=${APP_NAME}

# Installation des dependances systeme necessaires
RUN apk add --no-cache python3 make g++

# Creation du repertoire de travail
WORKDIR /app

# Copie du package.json et package-lock.json de l'application
COPY ${APP_NAME}/package.json ${APP_NAME}/package-lock.json* ./

# Installation des dependances avec NPM
RUN npm install

# Copie du reste du code source
COPY ${APP_NAME}/ ./

# Exposition du port
EXPOSE 3000

# Commande de demarrage avec hot-reload (watch mode)
CMD ["npm", "run", "start:dev"]
