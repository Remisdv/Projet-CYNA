# ===========================================
# CYNA Development Environment Configuration
# ===========================================
# Copy this file to .env and adjust values as needed

# Node Environment
NODE_ENV=development

# ===========================================
# DATABASE (PostgreSQL)
# ===========================================
POSTGRES_USER=cyna
POSTGRES_PASSWORD=cyna_password
POSTGRES_DB=cyna_db
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# ===========================================
# ELASTICSEARCH
# ===========================================
ELASTICSEARCH_URL=http://elasticsearch:9200

# ===========================================
# MAIL (MailHog)
# ===========================================
SMTP_HOST=mailhog
SMTP_PORT=1025

# ===========================================
# API PORTS
# ===========================================
GATEWAY_API_PORT=3000
BO_API_PORT=3001
WEBAPP_API_PORT=3002
SERVICE_API_PORT=3003

# ===========================================
# FRONTEND PORTS
# ===========================================
BO_FRONT_PORT=5173

# ===========================================
# API INTERNAL URLs (for Gateway health checks)
# ===========================================
BO_API_URL=http://cyna-bo-api:3000
WEBAPP_API_URL=http://cyna-webapp-api:3000
SERVICE_API_URL=http://cyna-service-api:3000
